# Database
DB_CONNECTION_STRING=Server=(localdb)\MSSQLLocalDB;Database=NewWebApp;Trusted_Connection=True;Pooling=true;Max Pool Size=100;Min Pool Size=5;

# JWT Authentication
JWT_KEY=your-256-bit-secret-key-here
JWT_ISSUER=your-app-name
JWT_AUDIENCE=your-app-name

# CORS (comma-separated origins, leave empty to deny all)
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
